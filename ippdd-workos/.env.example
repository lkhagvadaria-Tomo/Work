# ── Application ──────────────────────────────────────────────────────────────
# Public-safe (exposed to the browser).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (server-only) ───────────────────────────────────────────────────
# Local development: the local PostgreSQL created by scripts/db/local-setup.sh
# Production: the Supabase Postgres connection string (Settings → Database).
DATABASE_URL=postgres://workos:workos@localhost:5432/workos

# ── Supabase Auth (Google sign-in) ───────────────────────────────────────────
# Public-safe: URL + publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used ONLY for first-login employee linking. Never expose.
SUPABASE_SECRET_KEY=

# ── Google Workspace ─────────────────────────────────────────────────────────
# Allowed Workspace domain for sign-in (hd claim, verified server-side too).
GOOGLE_WORKSPACE_DOMAIN=netgroup.mn
# OAuth client for Drive metadata reads (server-only). The sign-in OAuth client
# is configured inside Supabase Auth, not here. Scopes are documented in
# docs/GOOGLE_DRIVE.md (least privilege: drive.metadata.readonly).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI (server-only) ─────────────────────────────────────────────────────────
# AI_PROVIDER: mock | anthropic   (mock needs no key; answers from system data only)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# ── Development only ─────────────────────────────────────────────────────────
# DEV_AUTH=1 enables the persona impersonation login. It is hard-disabled in
# production builds regardless of this flag (lib/auth/dev.ts).
DEV_AUTH=1
# HMAC secret for the dev session cookie (any long random string).
SESSION_SECRET=dev-only-change-me
